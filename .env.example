# ── ArxivDigest Configuration ──────────────────────

# Application
ENV=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=false
SCHEDULER_ENABLED=false
CRON_SECRET_KEY=change-me-for-external-cron

# JWT (change this to a secure random string in production!)
JWT_SECRET_KEY=your-secret-key-change-me

# Database
# Local (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./arxivdigest.db
# Production (Render Postgres example):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./arxivdigest.db

# SMTP Email Configuration
# QQ Mail example:
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_USE_TLS=true
SMTP_FROM_NAME=ArxivDigest
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true
