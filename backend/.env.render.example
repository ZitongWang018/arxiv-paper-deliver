ENV=production
DEBUG=false
# Free Render recommendation: disable in-process scheduler
SCHEDULER_ENABLED=false
CRON_SECRET_KEY=replace-with-long-random-secret

# Render backend public URL
BASE_URL=https://your-backend-service.onrender.com

# Vercel frontend public URL
FRONTEND_URL=https://your-frontend-app.vercel.app

# Comma-separated allowlist
CORS_ORIGINS=https://your-frontend-app.vercel.app
# Optional regex for preview domains (example for Vercel previews)
# CORS_ORIGIN_REGEX=^https://arxiv-paper-deliver.*\\.vercel\\.app$

# Render Postgres connection (usually auto-injected by render.yaml)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Security
JWT_SECRET_KEY=replace-with-long-random-secret

# SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_USE_TLS=true
SMTP_FROM_NAME=ArxivDigest

# Render free web service cannot send outbound traffic on SMTP ports.
# Use HTTPS email API provider instead (example: Resend).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
